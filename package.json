    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vis.gl/react-google-maps": "^1.9.0",
    "chrome-devtools-mcp": "^1.8.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "firebase": "^12.12.0",
    "googleapis": "^176.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "puppeteer": "^25.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.5.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
