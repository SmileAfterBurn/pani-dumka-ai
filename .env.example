# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ELEVENLABS_API_KEY: Optional. Used for custom high-quality voice synthesis via ElevenLabs.
ELEVENLABS_API_KEY="YOUR_ELEVENLABS_API_KEY"
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
VITE_ELEVENLABS_API_KEY="YOUR_VITE_ELEVENLABS_API_KEY"

# ELEVENLABS_VOICE_ID: Optional. ID of the custom voice to use in ElevenLabs
ELEVENLABS_VOICE_ID="XsDwVNgam5laFw4WF7S6"


